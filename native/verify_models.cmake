if(NOT DEFINED MODEL_DIR)
  message(FATAL_ERROR "MODEL_DIR is required")
endif()
file(READ "${MODEL_DIR}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON name MEMBER "${manifest}" files ${index})
  get_filename_component(leaf "${name}" NAME)
  if(NOT name STREQUAL leaf)
    message(FATAL_ERROR "Model manifest contains a non-local filename")
  endif()
  string(JSON expected GET "${manifest}" files "${name}")
  file(SHA256 "${MODEL_DIR}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Model checksum mismatch: ${name}. For an intentional glossary edit run tools/check_model_assets.py --refresh.")
  endif()
endforeach()
