# Evaluation tools stay opt-in when the native engine is embedded in an app.
function(luma_add_tool name source)
  add_executable(${name} "${LUMA_NATIVE_ROOT}/${source}")
  target_compile_features(${name} PRIVATE cxx_std_17)
  target_link_libraries(${name} PRIVATE luma::json)
  if(MSVC)
    target_compile_definitions(${name} PRIVATE NOMINMAX)
    target_compile_options(${name} PRIVATE /utf-8 /EHsc)
  endif()
endfunction()

