foreach(tool IN ITEMS luma_translate luma_ocr)
  if(tool STREQUAL "luma_translate")
    set(source translate_cli.cpp)
  else()
    set(source ocr_cli.cpp)
  endif()
  luma_add_tool(${tool} ${source})
  target_link_libraries(${tool} PRIVATE luma::translation_core)
  if(WIN32)
    add_custom_command(TARGET ${tool} POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "${LUMA_NATIVE_ROOT}/../windows/third_party/onnxruntime/onnxruntime.dll"
        "$<TARGET_FILE_DIR:${tool}>/onnxruntime.dll")
  endif()
endforeach()

